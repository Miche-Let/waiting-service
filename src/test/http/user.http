### 환경변수 설정
@gatewayUrl = http://localhost:19000
# internal은 게이트웨이 거치지 않고 직접 호출
@internalUrl = http://localhost:19200


### 테스트 USER 계정
@userLoginId = test9
@userPassword = test123!
@userName = user9
@userEmail = user009@naver.com
@userPhone = 010-1000-2006


### 대기 등록 후 아래 변수에 응답값 입력
@waitingId = 38301fc1-286d-41db-8e54-2d117897bf3f
@waitingToken = 4ebbf0ca-3cfe-431f-9ede-7043a1868f7b
@restaurantId = 456e7890-e89b-12d3-a456-428914164000

### 스케줄러 실행 후 ACTIVE 전환되면
### 대기 순번 조회 응답에서 accessToken 복사
@waitingAccessToken = dc091aea-63cb-4202-89a9-9a61ffbf378b


### 1. USER 회원가입
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "loginId": "{{userLoginId}}",
  "password": "{{userPassword}}",
  "name": "{{userName}}",
  "email": "{{userEmail}}",
  "phone": "{{userPhone}}",
  "userRole": "USER"
}


### 2. USER 로그인
POST {{gatewayUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "loginId": "{{userLoginId}}",
  "password": "{{userPassword}}"
}

> {%
    client.global.clear("userToken");
    let token = null;
    if (response.body.data && response.body.data.accessToken) {
        token = response.body.data.accessToken;
    } else if (response.body.data && response.body.data.token) {
        token = response.body.data.token;
    } else if (response.body.accessToken) {
        token = response.body.accessToken;
    }
    if (token) {
        client.global.set("userToken", token);
    }
%}


